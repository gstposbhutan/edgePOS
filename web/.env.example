# edgePOS web — environment reference. Copy to `.env` and fill in.
# `.env` is gitignored; NEVER commit real keys. NEXT_PUBLIC_* values are baked
# into the browser bundle at BUILD time — changing them requires a rebuild.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Kong gateway URL as the browser/edge reaches it. The server can override with
# SUPABASE_URL for internal networking (falls back to the public one).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8000
#SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, bypasses RLS. The BFF scopes every query by
# entityId instead; guard this key accordingly.
SUPABASE_SERVICE_ROLE_KEY=

# ── App identity (required) ─────────────────────────────────────────────────
# Public URL of this app (redirect targets, password-reset links).
NEXT_PUBLIC_APP_URL=https://pos.pelbu.com
# Auth-cookie domain. Set for production (dot-prefixed); leave EMPTY for
# localhost so the cookie stays host-scoped.
NEXT_PUBLIC_COOKIE_DOMAIN=.pelbu.com

# ── Email (SendGrid; transactional + OTP codes) ─────────────────────────────
# GoTrue sends auth mail (recovery links) via its own SMTP config in the
# Supabase stack — this key covers the app's direct sends (OTPs, notifications).
SENDGRID_API_KEY=
NOTIFY_FROM_EMAIL=noreply@app.pelbu.com
NOTIFY_FROM_NAME=Pelbu
# Contact-form inbox (defaults to the Innovates Bhutan address if unset).
#CONTACT_TO=

# ── Product images (S3 + CloudFront) ────────────────────────────────────────
# AWS credentials come from the EC2 instance role over IMDS — no keys on disk.
# Leave bucket/CDN empty to disable image upload (isStorageConfigured() gates it).
AWS_REGION=ap-south-2
S3_IMAGES_BUCKET=
IMAGE_CDN_URL=https://img.pelbu.com

# ── AI (optional — client deploys run with AI OFF; leave all empty) ─────────
# Payment-receipt OCR / bill scan provider: 'zhipu' | 'gemini'.
#VISION_AI_PROVIDER=zhipu
#ZHIPU_API_KEY=
#ZHIPU_VISION_MODEL=
# z.ai (GLM) product enrichment + cogview imagery.
#ZAI_API_KEY=
#ZAI_BASE_URL=
#ZAI_TEXT_MODEL=
#ZAI_VISION_MODEL=
#ZAI_IMAGE_MODEL=
#GEMINI_API_KEY=

# ── Desktop terminals ───────────────────────────────────────────────────────
# Shared secret the desktop release CI presents when ingesting a new build.
RELEASE_INGEST_TOKEN=
# PEM private key that signs terminal .lic files (lib/license/sign.js).
LICENSE_SIGNING_PRIVATE_KEY=

# ── Development only ────────────────────────────────────────────────────────
# 'true' short-circuits email/rider OTPs to the universal code 123456 and
# returns it in the API response. NEVER in production.
#MOCK_OTP=false
