{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CIPutReleaseObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::edgepos-images-430286912237-ap-south-2-an/releases/*"
    },
    {
      "Sid": "CIListMultipartUploads",
      "Effect": "Allow",
      "Action": "s3:ListBucketMultipartUploads",
      "Resource": "arn:aws:s3:::edgepos-images-430286912237-ap-south-2-an"
    }
  ]
}
