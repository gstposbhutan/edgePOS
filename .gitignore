# deps / builds
node_modules/
.next/
dist/
*.tsbuildinfo

# secrets — never commit env files
.env
.env.*
!.env.example

# Vision runtime + models — 38 MB of ONNX Runtime WASM copied out of node_modules by
# web/scripts/fetch-vision-assets.mjs (which `npm run build` runs), plus model files we do not
# author. Build inputs, not source.
web/public/onnx/
web/public/models/
web/public/mediapipe/

# test / recording output
web/e2e/recordings/
playwright-report/
test-results/
# Playwright auth states — real session tokens for the seeded test users, regenerated by
# auth-setup on every run. Never commit them.
web/e2e/storage/*.json

# DB dumps + financial-data samples — never commit
backups/

# live Supabase stack config copied from the box (contains secrets) — disk-only
infra-supabase-live/

# Per-user Claude Code permissions / settings
.claude/settings.local.json

# design mockup (binary, kept out of git history)
Pelbu UI.pptx
pelbu-product-import-template.xlsx
Hotel Items for Sales.xlsx
